# Salin menjadi .streamlit/secrets.toml untuk pengembangan lokal.
# Jangan commit secrets.toml.
# Untuk Streamlit Community Cloud, tempel isi file ini ke
# Advanced settings -> Secrets saat deploy.

DATABASE_URL = "postgresql+psycopg2://sapm_reader:PASSWORD_READONLY@HOST/neondb?sslmode=require"
DB_SCHEMA = "prestasi"
APP_ENV = "production"
MAX_UPLOAD_MB = 25
PUBLIC_READ_ONLY = "true"

# Hanya diperlukan saat menjalankan scripts/init_db.py --public.
# ANONYMIZATION_SALT = "ganti-dengan-string-acak-panjang-dan-tetap"
